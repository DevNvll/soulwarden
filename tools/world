#!/usr/bin/env python3
"""Development commands for the world of a development run.

The backend of a development run (tools/dev-run.sh, the scenario scripts) has the routes
/v1/dev/world, /v1/dev/items, and /v1/dev/progress. This tool sends a request to them. The backend is in the
network namespace of the launcher, thus the request goes with nsenter.

Usage:
  tools/world list                              the entities of the world
  tools/world characters                        the characters of the database (id and name)
  tools/world spawn CHARACTER --at X Y Z        put a character of the database into the world
                                                as an entity with no session, at a position
  tools/world spawn CHARACTER --near OTHER [DX DY DZ]
                                                the same, at a distance from the character OTHER,
                                                which is in the world (meters: east, north, up)
  tools/world remove CHARACTER                  remove an entity that has no session
  tools/world places [TEXT]                     the travel places of the game data (the spirit
                                                shrines and the inns of each territory) whose
                                                id, name, or territory has the text
  tools/world travel CHARACTER PLACE [--screen auto|on|off]
                                                move a character to a travel place (PLACE: an id
                                                of `tools/world places`, for example shrine_40170).
                                                A character that is in the world is there at once,
                                                with no new login. For a character that is not in
                                                the world, its row gets the place
  tools/world travel CHARACTER X Y Z [--screen auto|on|off]
                                                the same, to a position in meters (Z: a height on
                                                the ground, or above it: the character falls)
                                                --screen: the loading screen of the client (auto:
                                                a loading screen for a place more than 100 m away)
  tools/world path X0 Y0 Z0 X1 Y1 Z1 [--tsv FILE]
                                                the path of a creature between two places, by the
                                                navigation data of the backend: each corner of the
                                                path, its length, and the steps and the time of the
                                                search (a search with no limit of a tick). A place
                                                can be a character that is in the world (its name)
                                                in place of its three numbers. --tsv: the corners
                                                as a file for tools/research/nav_draw.py
  tools/world track CREATURE SECONDS [--tsv FILE]
                                                the places of a creature for some seconds (one line
                                                for each new place, 5 to 10 looks in a second): the
                                                way of a creature in a live fight. --tsv: the places
                                                as a file for tools/research/nav_draw.py
  tools/world heal CHARACTER                    give a character its full health. A dead character
                                                lives again at its place (the death screen closes)
  tools/world ignore CHARACTER on|off           the creatures ignore the character (on), or not
                                                (off): they do not get it as a target, and they do
                                                not attack it. The value stays until the backend stops
  tools/world hurt CHARACTER AMOUNT             a character takes damage. The health 0 is its death:
                                                its client shows the death screen
  tools/world touch CHARACTER                   send the full record of an entity again
  tools/world fragment CHARACTER SLOT TYPE HEX  give an entity one state fragment with these bytes:
                                                a live check of a state type that has no encoder
                                                (SLOT: index of the component in the slice, TYPE:
                                                type index of the state, HEX: the state bytes)
  tools/world message CHARACTER TYPE HEX        send the client of a character one message with
                                                these bytes: a live check of a message that has no
                                                code (TYPE: type index of the message, HEX: its
                                                body, which starts with the facet target and the
                                                entity of the component)

A probe entity (development aid, live check L4 of stage 3.3b-S2a): an entity of a slice of the game whose
states are only the fragments of the command. Each session near it gets its record (the metadata state of
the slice and the fragments), and its stop at the removal:
  tools/world probe CHARACTER ASSET [DX DY DZ] [--sub N] [--radius METERS] [--fragment SLOT:TYPE:HEX]...
                                                make a probe near a character (ASSET: the 32 hexadecimal
                                                digits of the asset id of the slice, or its text form
                                                D60BAED0-C08F-514F-9ECD-9BB5E20F7E9D; --sub: the sub id,
                                                default 2; --radius: the interest distance, default
                                                50 m). The reply has the entity id and the actor id
  tools/world probe fragment ENTITY SLOT TYPE HEX
                                                give a probe one more fragment (or a new one for a slot)
  tools/world probe remove ENTITY               remove a probe: each observer gets the stop

The items, the equipment, and the coin of a character (the character can be in the world or
not: a command for a character that is not in the world changes its rows in the database):
  tools/world items CHARACTER                   the items of the bag, the equipment, and the coin
  tools/world gear CHARACTER                    the gear of a character (stage 1.3b): the perks with an
                                                effect, the attribute bonus, the armor, the equip load,
                                                the effects, the item cooldowns, the rune charge
  tools/world perks CHARACTER SLOT P1,P2,P3,P4,P5 [--paperdoll]
                                                set the perks of the item of a bag slot (or of a
                                                paperdoll slot), with the checks and the swap of a give
  tools/world use CHARACTER SLOT [--paperdoll]  use the consumable of a bag slot (or of a quick slot
                                                14 to 19 with --paperdoll), with the rule of a client
  tools/world rune CHARACTER charge PERCENT|activate
                                                set the heart rune charge, or press the rune key
  tools/world status CHARACTER                  the status effects of a character (stage 3.3b-S1): each
                                                status with its seconds, stacks, potency, and source,
                                                the speed and armor parts, the counts
  tools/world status CHARACTER STATUS [SECONDS [COUNT]]
                                                put a status row of the game data on the character
                                                (SECONDS 0: the duration of the row; COUNT: 1 to 25
                                                applications, the stacks), with the rules of the game
  tools/world status CHARACTER remove STATUS|all
                                                end a status (not a status of the gear)
  tools/world perkroll ITEM [--gs N] [--level N] [--count N]
                                                roll the perks of a loot item N times (no item given)
  tools/world give CHARACTER ITEM [QUANTITY] [--action N] [--gs N] [--perks P1,P2,P3,P4,P5]
                                                give a quantity of an item (default 1). ITEM is
                                                the ItemID text of the item catalog, for example
                                                1hSwordT1 (tools/gamedata/items.sh --find ITEM).
                                                --action: the cause of the change on the wire
                                                (1: the loot notice of the HUD, protocol notes 4.10)
                                                --gs: the gear score (in the range of the item table)
                                                --perks: the PerkID of each of the five places
                                                (tools/gamedata/perks.sh --find TEXT; an empty part
                                                is a place with no perk; a gem is a perk of a place)
  tools/world take CHARACTER SLOT [QUANTITY]    remove the item of a slot, or a quantity of it
  tools/world coin CHARACTER AMOUNT             set the coin, for example 123.45
  tools/world move CHARACTER FROM TO            move the item of a slot to a different slot: an
                                                empty slot gets it, a stack of the same item takes
                                                what it can hold, a different item changes places
  tools/world split CHARACTER SLOT QUANTITY [TO]
                                                make a new stack from a quantity of a stack
  tools/world lock CHARACTER SLOT on|off        set or clear the lock of an item
  tools/world equipment CHARACTER               the items in the slots of the paperdoll
  tools/world equip CHARACTER BAGSLOT [SLOT]    move the item of a slot of the bag into a slot of
                                                the paperdoll. No SLOT: the slot of the item class
                                                (for a weapon the first free weapon slot). An item
                                                that is in the slot goes into the slot of the bag
  tools/world unequip CHARACTER SLOT [BAGSLOT]  move the item of a slot of the paperdoll into the
                                                bag (no BAGSLOT: the first empty slot)

The level, the attributes, and the skills of a character (the character can be in the world or
not, as for the items):
  tools/world progress CHARACTER                the level, the experience, the attributes, the
                                                weapon masteries, and the trade skills
  tools/world level CHARACTER LEVEL             set the level (the level of the screen). The
                                                experience becomes the start of the level
  tools/world xp CHARACTER AMOUNT               give experience: the level goes up at the limit
  tools/world attribute CHARACTER NAME VALUE    set the value of one attribute. NAME: constitution,
                                                focus, strength, dexterity, intelligence. The
                                                character must have the points for the value
  tools/world mastery CHARACTER WEAPON LEVEL [EXPERIENCE]
                                                set the mastery level of a weapon (1 to 20) and
                                                the experience in that level. Each level above 1
                                                gives one mastery point. WEAPON: sword, rapier,
                                                hatchet, flail, dagger, spear, greataxe,
                                                warhammer, greatsword, bow, musket, blunderbuss,
                                                firemagic, lifemagic, icemagic, voidgauntlet (or
                                                the id of the game table: SwordAbilityTable)
  tools/world tradeskill CHARACTER SKILL LEVEL [EXPERIENCE]
                                                set the level of a trade skill and the experience
                                                in that level. SKILL: Mining, Logging, Cooking, ...
  tools/world skillxp CHARACTER NAME AMOUNT     give experience to a weapon mastery or to a trade
                                                skill: its level goes up at the limit
  tools/world cooldowns CHARACTER [reset]       the cooldowns of the abilities of a character with the
                                                time that they have, and the counts of the abilities
                                                (reset: each cooldown ends; stage 3.3a)
  tools/world node CHARACTER WEAPON NODE...     spend one mastery point on each node of a weapon
                                                tree, in this sequence (NODE: the id text of the
                                                game table, Ability_WarHammer_WreckingBall). The
                                                rules of the tree apply, as for the client
  tools/world cast CHARACTER PLACE [--yaw DEGREES]
                                                press the key of place PLACE (0 Q, 1 R, 2 F) of the bar for a
                                                character, with the checks of a press of a client: a remote test
                                                character (tools/world spawn) casts Gravity Well; the server throws
                                                the projectile (--yaw: the direction, degrees from north to the east)
  tools/world spells                            the spell entities of the world (stage 3.3b-S2a) with their age
  tools/world spells end CHARACTER              each spell entity of a character ends (each observer gets the stop)
  tools/world bar CHARACTER WEAPON SLOT ABILITY put an active ability that the character has on a
                                                place (0 to 2) of the bar of a weapon (ABILITY: the
                                                id text of its node, or none: an empty place)

The creatures of the world (protocol notes 4.14):
  tools/world creatures [CHARACTER [RANGE]]     the creatures of the world. With a character: the
                                                distance of each one from it, the nearest one first
                                                (RANGE: only the creatures that are this near, meters)
  tools/world kinds [TEXT]                      the kinds of the creature data whose id, name, or
                                                family has the text
  tools/world creature spawn KIND CHARACTER [DX DY DZ] [--level N] [--yaw DEGREES]
                                                make a creature of a kind near a character that is
                                                in the world (meters: east, north, up; with no
                                                distance: 3 m to the north). KIND: Wolf_Grey_7
  tools/world creature remove CREATURE          take a creature out of the world
  tools/world creature health CREATURE VALUE    set the health: a number, or a part (50%)
  tools/world creature kill CREATURE            set the health to 0: the creature is dead
  tools/world creature reset                    each spawn point whose creature died or was removed
                                                makes its creature again
  tools/world creature action CREATURE NAME [SECONDS] [--tags HEX]
                                                start an action of the action table of the slice of
                                                a creature (Spawn, Attack_Bite, Idle): each client
                                                that observes it plays the action. SECONDS: the time
                                                of an action that has an end. --tags: the tag state
                                                of the fragments for this action (24 hexadecimal
                                                digits), in the place of the tags of the slice
  tools/world creature anchor CREATURE X Y Z    the anchor of a creature in a fight is that place
                                                (the end of its way back): a test of a way back
                                                with no path to the anchor
  tools/world creature respawn CREATURE SECONDS the spawn point of a dead creature makes its
                                                creature again in this time (from now), when a
                                                player is 150 m or less from it
  tools/world creature effect CREATURE STATUS [SECONDS]
                                                the creature takes a status effect of the ability
                                                data (WarHammer_Shockwave_Stun, GreatAxe_Vortex_Root,
                                                WarHammer_Ult_SlowOnCC), or knockdown or stagger, as
                                                from an ability (stage 3.3a)

The rewards of a kill (protocol notes 4.21):
  tools/world loot CHARACTER on|off             the loot switch: each kill of the character drops
                                                loot and coin (the outer chances pass), or the
                                                chances of the game data again
  tools/world roll KIND [LEVEL] [--count N] [--forced] [--character CHARACTER]
                                                roll the loot table of a kind N times (default 1)
                                                and count the items; nothing is given. LEVEL: the
                                                creature level (default: the level of the kind);
                                                --forced: the outer chance passes; --character:
                                                the level of that character (default: the creature
                                                level)
  tools/world fragment CREATURE SLOT TYPE HEX   the fragment command for a creature
CREATURE is the id of a creature (16 hexadecimal digits), or the last digits of it when only one
creature has them.

Slots of the paperdoll: 0 head, 1 chest, 2 hands, 3 legs, 4 feet, 5 amulet, 6 earring, 7 ring,
14 to 19 quick slots, 24 to 26 weapon 1 to 3, 27 to 29 the off hand item of weapon 1 to 3,
30 to 32 bags, 33 logging axe, 34 sickle, 35 skinning knife, 36 pickaxe, 37 fishing pole,
38 azoth staff, 45 heart rune.

CHARACTER is a character id, or the name of a character of the database. The session of a
client near the entity gets its record, and the client shows it as a remote player. The
position of a spawn does not go to the database.

The data directory is the development data directory (tools/dev-env.sh), or SOULWARDEN_DATA_DIR.
Status 0: the backend did the command. Status 1: it did not (the message says why).
"""

from __future__ import annotations

import json
import re
import sqlite3
import subprocess
import sys
import time
from pathlib import Path

sys.dont_write_bytecode = True  # keep __pycache__ out of the repository
sys.path.insert(0, str(Path(__file__).resolve().parent))
import dev_env  # noqa: E402

DEV_MARK = b"SOULWARDEN_DEV_RUN=1"
BACKEND_NAME = "soulwarden-backend"
SLOT_NAMES = {0: "head", 1: "chest", 2: "hands", 3: "legs", 4: "feet", 5: "amulet", 6: "earring", 7: "ring",
              24: "weapon 1", 25: "weapon 2", 26: "weapon 3", 27: "off hand 1", 28: "off hand 2", 29: "off hand 3",
              33: "logging axe", 34: "sickle", 35: "skinning knife", 36: "pickaxe", 37: "fishing pole",
              38: "azoth staff", 45: "heart rune"}
CHARACTER_ID = re.compile(r"^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$")


def fail(text: str) -> None:
    sys.exit(f"world: {text}")


def backend(data_dir: Path) -> tuple[int, int]:
    """@return The process id and the HTTP port of the backend of the development run with this data directory."""
    found = []
    for directory in Path("/proc").iterdir():
        if not directory.name.isdigit():
            continue
        try:
            # The program of the command line, not the name of the process: the kernel keeps
            # only the first 15 characters of a process name.
            arguments = (directory / "cmdline").read_bytes().split(b"\0")
            if Path(arguments[0].decode("utf-8", "replace")).name != BACKEND_NAME:
                continue
            if DEV_MARK not in (directory / "environ").read_bytes().split(b"\0"):
                continue
        except OSError:
            continue
        words = [word.decode("utf-8", "replace") for word in arguments]
        directory_of_run = words[words.index("--data-dir") + 1] if "--data-dir" in words[:-1] else ""
        port = int(words[words.index("--http-port") + 1]) if "--http-port" in words[:-1] else 32200
        if Path(directory_of_run) == data_dir:
            found.append((int(directory.name), port))
    if not found:
        fail(f"no backend of a development run uses the data directory {data_dir}. Start a run first.")
    return found[0]


def characters(data_dir: Path) -> list[tuple[str, str]]:
    """@return The id and the name of each character of the database."""
    database = data_dir / "soulwarden.sqlite3"
    if not database.is_file():
        fail(f"no database at {database}")
    connection = sqlite3.connect(f"file:{database}?mode=ro", uri=True)
    try:
        return [(row[0], row[1]) for row in
                connection.execute("select character_id, name from characters where deleted_date is null order by name")]
    finally:
        connection.close()


def character_id(data_dir: Path, text: str) -> str:
    if CHARACTER_ID.match(text):
        return text
    matches = [identifier for identifier, name in characters(data_dir) if name == text]
    if len(matches) != 1:
        fail(f"the database has no character with the name {text}")
    return matches[0]


def item_text(item: dict) -> str:
    marks = "".join(f" {mark}" for mark in ("bound", "locked") if item[mark])
    perks = ""
    if any(item.get("perks", [])):
        # The perks of the five places (stage 1.3b), with the index on the wire of each one (0: not in the perk data).
        perks = "\n" + " " * 10 + "perks: " + ", ".join(
            f"{name} ({index})" if name else "-" for name, index in zip(item["perks"], item.get("perkIndexes", [0] * 5)))
    return (f"{item['quantity']:>5} x {item['item']:<32} index {item['index']:>5}  gear score {item['gearScore']:>3}  "
            f"durability {item['durability']}/{item['maxDurability']}{marks}  instance {item['instance']}{perks}")


def meter_of(entry: dict) -> str:
    return f"{entry['count']} ({entry['mean']:.1f} us each, the largest {entry['largest']:.1f} us)"


def request(data_dir: Path, method: str, path: str, show_bag: bool = True, filter_text: str = "") -> None:
    process, port = backend(data_dir)
    command = ["nsenter", "-t", str(process), "-U", "-n", "--preserve-credentials", "curl", "--silent", "--max-time", "5",
               "--request", method, "--write-out", "\n%{http_code}", f"http://127.0.0.1:{port}{path}"]
    result = subprocess.run(command, capture_output=True, text=True, check=False)
    if result.returncode != 0:
        fail(f"no reply of the backend (nsenter and curl gave status {result.returncode}): {result.stderr.strip()}")
    body, _, status = result.stdout.rpartition("\n")
    try:
        document = json.loads(body)
    except ValueError:
        document = {"message": body}
    if isinstance(document, dict) and "weapons" in document:
        show_progress(document)
    elif isinstance(document, dict) and "spawnPointsWaiting" in document:
        show_creatures(document)
    elif isinstance(document, dict) and "kinds" in document:
        if not document["loaded"]:
            print("the backend has no creature data: make the file with tools/gamedata/creatures.sh")
        for kind in document["kinds"]:
            print(f"{kind['id']:<40} {kind['name']:<26} {kind['family']:<16} {kind['creatureType']:<10} level "
                  f"{kind['level']:>2}  health {kind['health']:9.1f}  {kind['spawnPoints']:>3} spawn point(s)  {kind['slice']}")
        print(f"{len(document['kinds'])} kinds")
    elif isinstance(document, dict) and "creature" in document:
        print("world: done: " + creature_text(document["creature"]))
    elif isinstance(document, dict) and "spawnPoints" in document and "applied" in document:
        print(f"world: done, {document['spawnPoints']} spawn point(s) that waited are free again")
    elif isinstance(document, dict) and "freeAttributePoints" in document:
        where = "the character is in the world" if document["applied"] == "world" else "the row only"
        gained = f", {document['levelsGained']} level(s) more" if document["levelsGained"] else ""
        print(f"world: done, level {document['level']}, experience {document['experience']}, "
              f"{document['freeAttributePoints']} free attribute point(s){gained} ({where})")
    elif isinstance(document, dict) and "freePoints" in document:
        where = "the character is in the world" if document["applied"] == "world" else "the rows only"
        print(f"world: done, rank {document['rank']}, experience {document['experience']}, "
              f"{document['freePoints']} free mastery point(s) ({where})")
    elif isinstance(document, dict) and "entities" in document:
        for entity in document["entities"]:
            show(entity)
        print(f"{len(document['entities'])} entities, revision {document['revision']}")
        load = document.get("load")
        if load:
            def meter(name: str) -> str:
                entry = load[name]
                return f"{entry['count']} ({entry['mean']:.1f} us each, the largest {entry['largest']:.1f} us)"
            print(f"load: ticks of the game server {meter('serverTick')}; ticks of the world {meter('worldTick')}; scans "
                  f"of the spawn points {meter('spawnScan')}; {load['spawnPoints']} spawn points, "
                  f"{load['spawnPointsLooked']} looked at in {load['spawnScans']} scans; {load['creatures']} creatures")
            if "behavior" in load:
                state = "on" if load.get("behaviorOn", True) else "OFF"
                print(f"behavior ({state}): steps {meter('behavior')}; {load['creaturesActive']} creatures in the step now "
                      f"(the largest number {load['creaturesActiveLargest']}), {load['creatureSteps']} creature steps, "
                      f"{load['creaturesSensed']} looks of the vision rule; {load['targets']} targets, {load['attacks']} "
                      f"attacks, {load['contactsHit']} contacts that did hurt and {load['contactsMissed']} that did not, "
                      f"{load['moves']} position changes, {load.get('targetsNoWay', 0)} targets with no way")
                if "roaming" in load:
                    print(f"roam: {load['roaming']} creatures patrol or wander near a character now (the largest number "
                          f"{load['roamingLargest']}), {load['roamSteps']} roam steps, {load['waypoints']} waypoints and "
                          f"{load['wanderPlaces']} places of a wander reached, {load['roamNoWay']} roam goals with no way; reset: "
                          f"{load['returns']} ways back, {load['holds']} waits at the place nearest to a target with no way, "
                          f"{load['retraces']} ways back on the trail, {load['jumps']} jumps to the anchor, {load['immuneHits']} "
                          f"hits on a creature on its way back")
            rewards = load.get("rewards")
            if rewards:
                if rewards["data"]:
                    print(f"rewards: {rewards['kills']} kills ({rewards['killsWithNoCredit']} with no character with the "
                          f"credit), {rewards['credited']} rewards of a character, {rewards['experience']} experience, "
                          f"{rewards['masteryExperience']} mastery experience, {rewards['coin'] / 100:.2f} coin, "
                          f"{rewards['lootGates']} loot chances that passed, {rewards['items']} items given, "
                          f"{rewards['itemsLost']} items not given; the time of the rewards {meter_of(rewards['time'])}; "
                          f"{load.get('spawnPointsWaiting', 0)} spawn points wait, {load.get('removedByRespawn', 0)} bodies "
                          f"removed at a respawn")
                else:
                    print("rewards: the backend has no loot tables (tools/gamedata/loot.sh makes them): a kill gives nothing")
            abilities = load.get("abilities")
            if abilities:
                print(abilities_text(abilities))
            spells = load.get("spells")
            if spells:
                print(spells_text(spells))
            navigation = load.get("navigation")
            if navigation and navigation["data"]:
                def part(entry: dict) -> str:
                    return f"{entry['count']} ({entry['mean']:.1f} us each, the largest {entry['largest']:.1f} us)"
                print(f"navigation: {navigation['tiles']} tiles ({navigation['tileBytes'] / 1048576:.1f} MB, the largest number "
                      f"{navigation['tilesLargest']}), tile reads {part(navigation['tileLoad'])}, {navigation['tilesDropped']} "
                      f"tiles removed, {navigation['tilesMissing']} with no data; searches of a tick "
                      f"{part(navigation['search'])}; {navigation['pathsDirect']} straight paths, {navigation['searches']} "
                      f"searches with {navigation['searchSteps']} steps (the largest number of steps in one tick "
                      f"{navigation['largestTickSteps']}), {navigation['searchesFailed']} with no path in the limit, "
                      f"{navigation['noWay']} goals with no way, {navigation.get('partialPaths', 0)} paths to the place nearest to a "
                      f"goal with no way; {navigation['queued']} searches wait now (the largest number "
                      f"{navigation['largestQueue']}), {navigation['waits']} steps of creatures that waited; "
                      f"{navigation['sightTests']} sight tests, {navigation['sightStopped']} stopped by a solid")
            elif navigation:
                print("navigation: no navigation data (tools/gamedata/navigation.sh makes it): a creature walks on the "
                      "straight line on the terrain")
    elif isinstance(document, dict) and "corners" in document:
        if not document["path"]:
            print(f"world: no path: {document['cause']} ({document['steps']} steps of the search, "
                  f"{document['microseconds'] / 1000:.2f} ms)")
            sys.exit(1)
        for corner in document["corners"]:
            print(f"{corner[0]:.3f} {corner[1]:.3f} {corner[2]:.3f}")
        kind = "a straight line that is free, no search" if document["direct"] else f"{document['steps']} steps of the search"
        print(f"{len(document['corners'])} corners, {document['length']:.2f} m, {document['cells']} cells, {kind}, "
              f"{document['microseconds'] / 1000:.2f} ms (with the read of the tiles)")
        if filter_text:
            Path(filter_text).write_text("kind\tx\ty\tz\n" + "".join(
                f"corner\t{corner[0]:.3f}\t{corner[1]:.3f}\t{corner[2]:.3f}\n" for corner in document["corners"]))
            print(f"the corners are in {filter_text}")
    elif isinstance(document, dict) and "places" in document and "loaded" in document:
        if not document["loaded"]:
            print("the backend has no travel places: make the file with tools/gamedata/places.sh")
        words = [word.lower() for word in (filter_text or "").split()]
        shown = 0
        for place in document["places"]:
            text = f"{place['id']} {place['name']} {place['territory']} {place['kind']}".lower()
            if all(word in text for word in words):
                x, y, z = place["position"]
                print(f"{place['id']:<20} {place['kind']:<7} {place['territory']:<20} {place['name']:<36} "
                      f"{x:.3f} {y:.3f} {z:.3f}")
                shown += 1
        print(f"{shown} of {len(document['places'])} travel places")
    elif isinstance(document, dict) and "creaturesIgnore" in document:
        where = "the character is in the world" if document.get("inWorld") else "the character is not in the world"
        state = ""
        if "health" in document:
            state = (f", health {document['health']:.1f} of {document['healthMax']:.1f}"
                     f"{' DEAD' if document.get('dead') else ''}")
        ignore = "the creatures ignore it" if document["creaturesIgnore"] else "the creatures do not ignore it"
        loot = "; each kill drops loot and coin (the loot switch)" if document.get("forceLoot") else ""
        print(f"world: {document.get('message', 'done')}{state}; {ignore}{loot} ({where})")
    elif isinstance(document, dict) and "applied" in document and "position" in document:
        x, y, z = document["position"]
        place = document.get("place")
        where = f"{place['name']} ({place['territory']}), " if place else ""
        if document["applied"] == "world":
            print(f"world: done, the character is at {where}{x:.3f} {y:.3f} {z:.3f} ({document['distance']:.1f} m from "
                  "its place before)")
        else:
            print(f"world: done, the character is not in the world: its row has {where}{x:.3f} {y:.3f} {z:.3f}, and its "
                  "next world entry is there")
    elif isinstance(document, dict) and "rollsWithLoot" in document:
        print(f"{document['kind']} (vitals row {document['vitals']}, loot table {document['table'] or 'none'}, tags "
              f"{','.join(document['tags']) or 'none'}, drops loot: {document['canDropLoot']}, outer chance "
              f"{document['dropChance']}): creature level {document['creatureLevel']}, character level "
              f"{document['characterLevel']}, {document['rolls']} rolls{' (the outer chance passes)' if document['forced'] else ''}")
        for item in sorted(document["items"], key=lambda entry: -entry["rolls"]):
            print(f"  {item['rolls']:>6} roll(s)  {item['quantity']:>7} x {item['item']}")
        print(f"{document['rollsWithLoot']} of {document['rolls']} rolls gave an item; "
              f"{len(document['items'])} different items")
    elif isinstance(document, dict) and "entity" in document:
        show(document)
    elif isinstance(document, dict) and "items" in document:
        place = "in the world" if document["inWorld"] else "not in the world"
        equipment = document.get("equipment", [])
        if show_bag:
            for item in document["items"]:
                print(f"slot {item['slot']:>3}  {item_text(item)}")
            print(f"{len(document['items'])} items in {document['slots']} slots, coin {document['coin'] // 100}."
                  f"{document['coin'] % 100:02d} (the character is {place})")
        for item in equipment:
            name = SLOT_NAMES.get(item["slot"], "")
            print(f"paperdoll slot {item['slot']:>2} {name:<14} {item_text(item)}")
        print(f"{len(equipment)} items in the paperdoll" + ("" if show_bag else f" (the character is {place})"))
    elif isinstance(document, dict) and "applied" in document and "slots" not in document:
        print(f"world: {document.get('message', 'done')}")
    elif isinstance(document, dict) and "applied" in document:
        where = "the character is in the world" if document["applied"] == "world" else "the rows only"
        paperdoll = document.get("equipmentSlots", [])
        print(f"world: done, changed slots {document['slots']}"
              + (f", changed slots of the paperdoll {paperdoll}" if paperdoll else "") + f" ({where})")
    else:
        print(f"world: {document.get('message', body)}")
    if status == "404" and (path == "/v1/dev/world" or ("message" not in document and
                                                        path.startswith(("/v1/dev/items", "/v1/dev/progress")))):
        fail("the backend has no development commands (start it with tools/dev-run.sh)")
    if status != "200":
        sys.exit(1)


def spells_text(spells: dict) -> str:
    """@return The lines `spells` of the list (stage 3.3b-S2a): the spell entities with their age, and the counts."""
    if not spells["data"]:
        head = "spells: the backend has no spell data (tools/gamedata/spells.sh): a spell has its hits and no record"
    else:
        head = "spells:"
    ended = ", ".join(f"{count} {cause}" for cause, count in spells["ended"].items() if count)
    lines = [f"{head} {len(spells['spells'])} in the world, {spells['made']} made, ended: {ended or 'none'}; {spells['phases']} phases ran, "
             f"{spells['phasesCancelled']} cancelled, {spells['dueTaken']} due entries taken, {spells['largest']} at one time at most"]
    for spell in spells["spells"]:
        x, y, z = spell["position"]
        lines.append(f"  spell {spell['entity']}  {spell['spell']} of {spell['caster']}  age {spell['age']:.2f} s, {spell['left']:.2f} s left  "
                     f"at {x:.2f} {y:.2f} {z:.2f}{'' if spell['record'] else '  (no record: no slice data)'}")
    return "\n".join(lines)


def abilities_text(abilities: dict) -> str:
    """@return The line `abilities` of the list: the presses by cause, the hits, and the effects (stage 3.3a)."""
    if not abilities["loaded"]:
        return "abilities: the backend has no ability data (tools/gamedata/abilities.sh) or no combat tables: each press is refused"
    presses = abilities["presses"]
    refused = ", ".join(f"{count} {cause}" for cause, count in presses.items() if cause != "accepted" and count)
    return (f"abilities: {presses['accepted']} casts, refused presses: {refused or 'none'}; {abilities['contactHits']} hits of a "
            f"contact, {abilities['areaHits']} hits of an area ({abilities['areaLooked']} entities looked at), "
            f"{abilities['shots']} shots, {abilities['vortexes']} vortexes, {abilities['effects']} effects given, "
            f"{abilities['effectsRefused']} not taken, {abilities['blocked']} stopped by a wall"
            + (f"; {abilities['counters']} counters, {abilities['counterHits']} counter hits" if "counters" in abilities else "")
            + (f"\nforce: {abilities['forced']['moving']} creatures move by a pull or a push now, {abilities['forced']['started']} "
               f"movements started ({abilities['forced']['replaced']} replaced, {abilities['forced']['refused']} not taken), "
               f"{abilities['forced']['steps']} steps, {abilities['forced']['blocked']} stopped by a wall or a drop, the largest "
               f"number at one time {abilities['forced']['largest']}" if "forced" in abilities else ""))


def fetch(data_dir: Path, path: str) -> dict:
    """@return The JSON reply of a GET request, with no output."""
    process, port = backend(data_dir)
    command = ["nsenter", "-t", str(process), "-U", "-n", "--preserve-credentials", "curl", "--silent", "--max-time", "5",
               f"http://127.0.0.1:{port}{path}"]
    result = subprocess.run(command, capture_output=True, text=True, check=False)
    if result.returncode != 0:
        fail(f"no reply of the backend (nsenter and curl gave status {result.returncode}): {result.stderr.strip()}")
    try:
        return json.loads(result.stdout)
    except ValueError:
        fail("the backend has no development commands for creatures (start it with tools/dev-run.sh)")
        return {}


def creature_id(data_dir: Path, text: str) -> str:
    """@return The id of the creature whose id is the text, or ends with it."""
    if not re.fullmatch(r"[0-9a-fA-F]{1,16}", text):
        fail("the creature must be its id (hexadecimal digits)")
    if len(text) == 16:
        return text.lower()
    found = [creature["id"] for creature in fetch(data_dir, "/v1/dev/creatures").get("creatures", [])
             if creature["id"].endswith(text.lower())]
    if len(found) != 1:
        fail(f"{len(found)} creatures of the world have an id that ends with {text}")
    return found[0]


def creature_text(creature: dict) -> str:
    x, y, z = creature["position"]
    distance = f"  {creature['distance']:6.1f} m" if "distance" in creature else ""
    # What the creature does: it has a target, or it goes to its home. No word: it is at rest.
    mode = {"fight": f"  FIGHT (target {creature.get('target', '')[-8:]})", "home": "  GOES BACK (immune)"}.get(creature.get("mode"), "")
    if creature.get("holds"):
        mode += "  WAITS (no way to its target)"
    if creature.get("retracing"):
        mode += "  ON ITS TRAIL"
    if creature.get("forced"):
        mode += f"  MOVED BY A HIT ({creature['forced']})"
    # The roam (stage 3.4e): a patrol with its waypoint, or a wander, and if the creature roams now (a character is near).
    roam = creature.get("roam", "none")
    stands = ""
    if not creature.get("roaming") and creature.get("mode") == "rest":
        if not creature.get("behaviorData", True):
            stands = "stands: no behavior data of its slice"
        elif not creature.get("groundKnown"):
            stands = "stands: no navigation data of its place yet"
        elif not creature.get("walks"):
            stands = "stands: no free floor at its place"
        else:
            stands = "stands: no character near"
    if roam == "patrol":
        mode += f"  PATROL (waypoint {creature.get('waypoint', 0) + 1} of {creature.get('waypoints', 0)}"
        if creature.get("settled"):
            mode += ", stays there)"
        else:
            mode += f", {stands})" if stands else ")"
    elif roam == "wander":
        mode += "  WANDER" + (f" ({stands})" if stands else "")
    kind = "" if creature.get("fights", True) else "  no attack"
    rooted = creature.get("groundKnown", True) and not creature.get("walks", True)
    kind += "  stays at its place" if rooted and creature.get("fights", True) else ""
    if "respawnIn" in creature:
        kind += f"  its spawn point makes a new creature in {creature['respawnIn']:.0f} s (a player near it)"
    return (f"creature {creature['id']}  {creature['kind']:<28} {creature['name']:<22} level {creature['level']:>2}  "
            f"health {creature['health']:.1f} of {creature['healthMax']:.1f}{'  DEAD' if creature['dead'] else ''}  "
            f"position {x:.3f} {y:.3f} {z:.3f}{distance}  {'spawn point' if creature['spawnPoint'] else 'command'}"
            f"{mode}{kind}")


def show_creatures(document: dict) -> None:
    if not document["data"]:
        print("the backend has no creature data: make the file with tools/gamedata/creatures.sh")
        return
    for creature in document["creatures"]:
        print(creature_text(creature))
    counts = document["counts"]
    print(f"{len(document['creatures'])} creatures in the list, {document['total']} in the world; "
          f"{document['spawnPoints']} spawn points, {document['spawnPointsWaiting']} of them wait; made by a spawn point "
          f"{counts['spawnedByPoint']}, by a command {counts['spawnedByCommand']}; removed by the distance rule "
          f"{counts['removedByDistance']}, by a command {counts['removedByCommand']}; deaths {counts['deaths']}; the "
          f"largest number at one time {counts['largest']}")


def show_progress(document: dict) -> None:
    place = "in the world" if document["inWorld"] else "not in the world"
    following = document["nextLevelExperience"]
    print(f"level {document['level']}, experience {document['experience']}"
          + (f" (the next level starts at {following})" if following else "")
          + f", health {document['health']:.0f} of {document['healthMax']:.0f} (the character is {place})")
    values = ", ".join(f"{name} {entry['value']}" for name, entry in document["attributes"].items())
    print(f"attributes: {values}; {document['freeAttributePoints']} free point(s)")
    if not document["tables"]:
        print("the backend has no progression tables: no list of the weapons and of the trade skills")
        return
    for weapon in document["weapons"]:
        if weapon["level"] == 1 and not weapon["experience"] and not weapon["nodes"]:
            continue
        bar = ", ".join(place or "-" for place in weapon["bar"])
        print(f"weapon {weapon['id']:<26} level {weapon['level']:>2}, experience {weapon['experience']} of "
              f"{weapon['nextLevel']}, {weapon['freePoints']} free and {weapon['spentPoints']} spent point(s)")
        if weapon["nodes"]:
            print(f"    nodes: {', '.join(weapon['nodes'])}")
            print(f"    bar: {bar}")
    for skill in document["tradeSkills"]:
        if skill["level"] or skill["experience"]:
            print(f"trade skill {skill['id']:<21} level {skill['level']:>3}, experience {skill['experience']} of "
                  f"{skill['nextLevel']}")
    weapons = sum(1 for weapon in document["weapons"] if weapon["level"] > 1 or weapon["experience"] or weapon["nodes"])
    skills = sum(1 for skill in document["tradeSkills"] if skill["level"] or skill["experience"])
    print(f"{weapons} of {len(document['weapons'])} weapons and {skills} of {len(document['tradeSkills'])} trade skills "
          "are above the start")


def show(entity: dict) -> None:
    x, y, z = entity["position"]
    session = f"session s{entity['session']}" if entity["session"] else "no session"
    owner = entity["character"] or f"({entity.get('kind', 'entity')})"
    health = ""
    if "health" in entity and entity.get("kind") in ("player", "creature"):
        health = f"  health {entity['health']:.1f} of {entity['healthMax']:.1f}{'  DEAD' if entity.get('dead') else ''}"
    print(f"entity {entity['entity']}  actor {entity['actor']}  {entity['name']:<16} {owner}  "
          f"{session:<11} position {x:.3f} {y:.3f} {z:.3f}{health}")


def whole(word: str, what: str) -> int:
    if not word.isdigit():
        fail(f"{what} must be a whole number, 0 or more")
    return int(word)


def coin_amount(word: str) -> int:
    """@return The amount in hundredths of a coin from a text such as 123.45."""
    if not re.fullmatch(r"[0-9]+(\.[0-9]{1,2})?", word):
        fail("give the coin as a number with 2 decimals at most, for example 123.45")
    units, _, cents = word.partition(".")
    return int(units) * 100 + int(cents.ljust(2, "0") or 0)


def numbers(words: list[str], count: int) -> list[float]:
    try:
        values = [float(word) for word in words]
    except ValueError:
        fail("a distance or a position must be a number")
    if len(values) != count:
        fail(f"give {count} numbers")
    return values


def creature_command(data_dir: Path, arguments: list[str]) -> None:
    action = arguments[0]
    if action == "spawn" and len(arguments) >= 3:
        options = ""
        words = arguments[3:]
        for name in ("--level", "--yaw"):
            if name in words:
                place = words.index(name)
                if place + 1 >= len(words):
                    fail(f"give a value after {name}")
                value = whole(words[place + 1], "the level") if name == "--level" else numbers(words[place + 1:place + 2], 1)[0]
                options += f"&{name[2:]}={value}"
                del words[place:place + 2]
        if not re.fullmatch(r"[A-Za-z0-9_:+-]+", arguments[1]):
            fail("the kind must be an id of the creature data (tools/world kinds)")
        if words:
            dx, dy, dz = numbers(words, 3)
            options += f"&dx={dx}&dy={dy}&dz={dz}"
        request(data_dir, "POST", f"/v1/dev/creatures/spawn?character={character_id(data_dir, arguments[2])}"
                                  f"&kind={arguments[1]}{options}")
    elif action in ("remove", "kill") and len(arguments) == 2:
        request(data_dir, "POST", f"/v1/dev/creatures/{action}?creature={creature_id(data_dir, arguments[1])}")
    elif action == "health" and len(arguments) == 3:
        value = arguments[2]
        if value.endswith("%"):
            amount = f"percent={numbers([value[:-1]], 1)[0]}"
        else:
            amount = f"health={numbers([value], 1)[0]}"
        request(data_dir, "POST", f"/v1/dev/creatures/health?creature={creature_id(data_dir, arguments[1])}&{amount}")
    elif action == "reset" and len(arguments) == 1:
        request(data_dir, "POST", "/v1/dev/creatures/reset")
    elif action == "action" and len(arguments) >= 3:
        words = arguments[3:]
        tags = ""
        if "--tags" in words:
            place = words.index("--tags")
            if place + 1 >= len(words) or not re.fullmatch(r"[0-9a-fA-F]{24}", words[place + 1]):
                fail("give 24 hexadecimal digits after --tags")
            tags = f"&tags={words[place + 1]}"
            del words[place:place + 2]
        if not re.fullmatch(r"[A-Za-z0-9_]+", arguments[2]) or len(words) > 1:
            fail("the action must be a name of the action table of the slice (letters, digits, and _)")
        seconds = f"&seconds={numbers(words, 1)[0]}" if words else ""
        request(data_dir, "POST", f"/v1/dev/creatures/action?creature={creature_id(data_dir, arguments[1])}"
                                  f"&action={arguments[2]}{seconds}{tags}")
    elif action == "anchor" and len(arguments) == 5:
        x, y, z = numbers(arguments[2:5], 3)
        request(data_dir, "POST", f"/v1/dev/creatures/anchor?creature={creature_id(data_dir, arguments[1])}&x={x}&y={y}&z={z}")
    elif action == "respawn" and len(arguments) == 3:
        seconds = numbers(arguments[2:3], 1)[0]
        request(data_dir, "POST", f"/v1/dev/creatures/respawn?creature={creature_id(data_dir, arguments[1])}&seconds={seconds}")
    elif action == "effect" and len(arguments) in (3, 4):
        if not re.fullmatch(r"[A-Za-z0-9_]+", arguments[2]):
            fail("the status must be the id of a status row of the ability data, or knockdown or stagger")
        seconds = f"&seconds={numbers(arguments[3:4], 1)[0]}" if len(arguments) == 4 else ""
        request(data_dir, "POST", f"/v1/dev/creatures/effect?creature={creature_id(data_dir, arguments[1])}"
                                  f"&status={arguments[2]}{seconds}")
    else:
        fail("unknown creature command. tools/world --help prints the commands.")


def main() -> None:
    arguments = sys.argv[1:]
    if not arguments or arguments[0] in ("-h", "--help"):
        print(__doc__.strip())
        return
    data_dir = dev_env.data_dir()
    command = arguments[0]
    if command == "list" and len(arguments) == 1:
        request(data_dir, "GET", "/v1/dev/world")
    elif command == "characters" and len(arguments) == 1:
        for identifier, name in characters(data_dir):
            print(f"{identifier}  {name}")
    elif command == "spawn" and len(arguments) >= 3:
        target = character_id(data_dir, arguments[1])
        if arguments[2] == "--at":
            x, y, z = numbers(arguments[3:], 3)
            request(data_dir, "POST", f"/v1/dev/world/spawn?character={target}&x={x}&y={y}&z={z}")
        elif arguments[2] == "--near" and len(arguments) >= 4:
            other = character_id(data_dir, arguments[3])
            dx, dy, dz = numbers(arguments[4:], 3) if len(arguments) > 4 else (2.0, 2.0, 0.0)
            request(data_dir, "POST", f"/v1/dev/world/spawn?character={target}&near={other}&dx={dx}&dy={dy}&dz={dz}")
        else:
            fail("give the position: --at X Y Z, or --near OTHER [DX DY DZ]")
    elif command == "fragment" and len(arguments) == 5:
        try:
            slot, type_index = int(arguments[2]), int(arguments[3])
            state = bytes.fromhex(arguments[4]).hex()
        except ValueError:
            fail("give the slot and the type as numbers, and the state as hexadecimal text")
        # A text of hexadecimal digits that is not the name of a character is the id of a creature.
        names = [name for _, name in characters(data_dir)]
        if re.fullmatch(r"[0-9a-fA-F]{1,16}", arguments[1]) and arguments[1] not in names:
            target = f"creature={creature_id(data_dir, arguments[1])}"
        else:
            target = f"character={character_id(data_dir, arguments[1])}"
        request(data_dir, "POST", f"/v1/dev/world/fragment?{target}&slot={slot}&type={type_index}&state={state}")
    elif command == "probe" and len(arguments) >= 3:
        if arguments[1] == "remove" and len(arguments) == 3:
            request(data_dir, "POST", f"/v1/dev/world/probe/remove?entity={arguments[2].lower()}")
            return
        if arguments[1] == "fragment" and len(arguments) == 6:
            try:
                slot, type_index = int(arguments[3]), int(arguments[4])
                state = bytes.fromhex(arguments[5]).hex()
            except ValueError:
                fail("give the slot and the type as numbers, and the state as hexadecimal text")
            request(data_dir, "POST", f"/v1/dev/world/fragment?entity={arguments[2].lower()}&slot={slot}"
                                      f"&type={type_index}&state={state}")
            return
        target = character_id(data_dir, arguments[1])
        asset = arguments[2].replace("-", "").lower()
        if not re.fullmatch(r"[0-9a-f]{32}", asset):
            fail("give the asset id of the slice: 32 hexadecimal digits")
        rest = arguments[3:]
        options = {"--sub": "2", "--radius": ""}
        fragments: list[str] = []
        offsets: list[str] = []
        index = 0
        while index < len(rest):
            word = rest[index]
            if word in options and index + 1 < len(rest):
                options[word] = rest[index + 1]
                index += 2
            elif word == "--fragment" and index + 1 < len(rest):
                part = rest[index + 1].split(":")
                if len(part) != 3:
                    fail("a fragment is SLOT:TYPE:HEX")
                try:
                    fragments.append(f"{int(part[0])}:{int(part[1])}:{bytes.fromhex(part[2]).hex()}")
                except ValueError:
                    fail("a fragment is SLOT:TYPE:HEX (numbers and hexadecimal text)")
                index += 2
            else:
                offsets.append(word)
                index += 1
        dx, dy, dz = numbers(offsets, 3) if offsets else (0.0, 3.0, 0.0)
        query = f"near={target}&asset={asset}&sub={whole(options['--sub'], 'the sub id')}&dx={dx}&dy={dy}&dz={dz}"
        if options["--radius"]:
            query += f"&radius={numbers([options['--radius']], 1)[0]}"
        if fragments:
            query += "&fragments=" + ",".join(fragments)
        request(data_dir, "POST", f"/v1/dev/world/probe?{query}")
    elif command == "cast" and len(arguments) in (3, 5) and (len(arguments) == 3 or arguments[3] == "--yaw"):
        yaw = numbers(arguments[4:], 1)[0] if len(arguments) == 5 else 0.0
        request(data_dir, "POST", f"/v1/dev/abilities/cast?character={character_id(data_dir, arguments[1])}"
                                  f"&place={whole(arguments[2], 'the place')}&yaw={yaw}")
    elif command == "spells" and len(arguments) == 1:
        document = fetch(data_dir, "/v1/dev/world")
        print(spells_text(document["load"]["spells"]))
    elif command == "spells" and len(arguments) == 3 and arguments[1] == "end":
        request(data_dir, "POST", f"/v1/dev/spells/end?character={character_id(data_dir, arguments[2])}")
    elif command == "message" and len(arguments) == 4:
        try:
            type_index = int(arguments[2])
            body = bytes.fromhex(arguments[3]).hex()
        except ValueError:
            fail("give the type as a number, and the body as hexadecimal text")
        request(data_dir, "POST", f"/v1/dev/world/message?character={character_id(data_dir, arguments[1])}"
                                  f"&type={type_index}&body={body}")
    elif command == "creatures" and len(arguments) in (1, 2, 3):
        query = f"?character={character_id(data_dir, arguments[1])}" if len(arguments) > 1 else ""
        if len(arguments) == 3:
            query += f"&range={numbers(arguments[2:], 1)[0]}"
        request(data_dir, "GET", f"/v1/dev/creatures{query}")
    elif command == "kinds" and len(arguments) in (1, 2):
        if len(arguments) == 2 and not re.fullmatch(r"[A-Za-z0-9_:+-]+", arguments[1]):
            fail("the text can have letters, digits, and the characters _ : + -")
        request(data_dir, "GET", "/v1/dev/creatures/kinds" + (f"?q={arguments[1]}" if len(arguments) == 2 else ""))
    elif command == "creature" and len(arguments) >= 2:
        creature_command(data_dir, arguments[1:])
    elif command == "items" and len(arguments) == 2:
