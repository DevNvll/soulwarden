from pathlib import Path

sys.dont_write_bytecode = True  # keep __pycache__ out of the repository
sys.path.insert(0, str(Path(__file__).resolve().parent))
import dev_env  # noqa: E402

DEV_MARK = b"SOULWARDEN_DEV_RUN=1"
BACKEND_NAME = "soulwarden-backend"
SLOT_NAMES = {0: "head", 1: "chest", 2: "hands", 3: "legs", 4: "feet", 5: "amulet", 6: "earring", 7: "ring",
              24: "weapon 1", 25: "weapon 2", 26: "weapon 3", 27: "off hand 1", 28: "off hand 2", 29: "off hand 3",
              33: "logging axe", 34: "sickle", 35: "skinning knife", 36: "pickaxe", 37: "fishing pole",
              38: "azoth staff", 45: "heart rune"}
CHARACTER_ID = re.compile(r"^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$")


def fail(text: str) -> None:
    sys.exit(f"world: {text}")


def backend(data_dir: Path) -> tuple[int, int]:
    """@return The process id and the HTTP port of the backend of the development run with this data directory."""
    found = []
    for directory in Path("/proc").iterdir():
        if not directory.name.isdigit():
            continue
        try:
            # The program of the command line, not the name of the process: the kernel keeps
            # only the first 15 characters of a process name.
            arguments = (directory / "cmdline").read_bytes().split(b"\0")
            if Path(arguments[0].decode("utf-8", "replace")).name != BACKEND_NAME:
                continue
            if DEV_MARK not in (directory / "environ").read_bytes().split(b"\0"):
                continue
        except OSError:
            continue
        words = [word.decode("utf-8", "replace") for word in arguments]
        directory_of_run = words[words.index("--data-dir") + 1] if "--data-dir" in words[:-1] else ""
        port = int(words[words.index("--http-port") + 1]) if "--http-port" in words[:-1] else 32200
        if Path(directory_of_run) == data_dir:
            found.append((int(directory.name), port))
    if not found:
        fail(f"no backend of a development run uses the data directory {data_dir}. Start a run first.")
    return found[0]


def characters(data_dir: Path) -> list[tuple[str, str]]:
    """@return The id and the name of each character of the database."""
    database = data_dir / "soulwarden.sqlite3"
    if not database.is_file():
        fail(f"no database at {database}")
    connection = sqlite3.connect(f"file:{database}?mode=ro", uri=True)
    try:
        return [(row[0], row[1]) for row in
                connection.execute("select character_id, name from characters where deleted_date is null order by name")]
    finally:
        connection.close()


def character_id(data_dir: Path, text: str) -> str:
    if CHARACTER_ID.match(text):
        return text
    matches = [identifier for identifier, name in characters(data_dir) if name == text]
    if len(matches) != 1:
        fail(f"the database has no character with the name {text}")
    return matches[0]


def item_text(item: dict) -> str:
    marks = "".join(f" {mark}" for mark in ("bound", "locked") if item[mark])
    perks = ""
    if any(item.get("perks", [])):
        # The perks of the five places (stage 1.3b), with the index on the wire of each one (0: not in the perk data).
        perks = "\n" + " " * 10 + "perks: " + ", ".join(
            f"{name} ({index})" if name else "-" for name, index in zip(item["perks"], item.get("perkIndexes", [0] * 5)))
    return (f"{item['quantity']:>5} x {item['item']:<32} index {item['index']:>5}  gear score {item['gearScore']:>3}  "
            f"durability {item['durability']}/{item['maxDurability']}{marks}  instance {item['instance']}{perks}")


def meter_of(entry: dict) -> str:
    return f"{entry['count']} ({entry['mean']:.1f} us each, the largest {entry['largest']:.1f} us)"


def world_time_text(time: dict) -> str:
    """@return One line of the world time (stage 2.2)."""
    cycle = time["cycle"]
    counts = time["counts"]
    return (f"{time['time']} ({time['phase']}), {time['nextPhase']} in {time['secondsToNextPhase']:.0f} s; a cycle of "
            f"{cycle['seconds']} s ({cycle['dayLength']} s of day from {cycle['dawn']}, {cycle['nightLength']} s of night from "
            f"{cycle['dusk']}); {'stored position at the start' if counts['loaded'] else 'a new world at noon'}, "
            f"{counts['phaseChanges']} phase changes, {counts['sets']} commands, {counts['saves']} saves "
            f"({counts['failedSaves']} failed)")


def save_quest_support(data_dir: Path, output: Path) -> None:
    """Stage 1.8e: writes the support manifest of the quest data (some MB) to a file, then shows its counts."""
    process, port = backend(data_dir)
    command = ["nsenter", "-t", str(process), "-U", "-n", "--preserve-credentials", "curl", "--silent", "--max-time", "120",
               "--output", str(output), "--write-out", "%{http_code}", f"http://127.0.0.1:{port}/v1/dev/quests/support"]
    result = subprocess.run(command, capture_output=True, text=True, check=False)
    if result.returncode != 0 or result.stdout.strip() != "200":
        fail(f"no manifest of the backend (status {result.returncode}, HTTP {result.stdout.strip()}): {result.stderr.strip()}")
    counts = json.loads(output.read_text())["counts"]
    print(f"world: the support manifest is in {output}: {counts['rows']} rows ({', '.join(f'{k} {v}' for k, v in counts['kinds'].items())}), "
          f"{counts['supported']} supported, {counts['primaryCompletable']} completable in the history {counts['primaryProfile']}")


