def show_tree(document: dict) -> None:
    """Prints the behavior tree of a creature (stage BT1): its last step, the result of each node (+ success, - failure, ~ running, . the
    step did not run the node), the parameters of each leaf, and the blackboard."""
    step = document["step"]
    ago = f"{step['secondsAgo']:.1f} s ago" if step["secondsAgo"] >= 0 else "no step yet"
    print(f"creature {document['creature']} ({document['kind']}), mode {document['mode']}, tree {document.get('tree', '(none)')} "
          f"({document.get('source', '')})")
    decided = f", the leaf that decided: {step['decided']}" if step["decided"] else ""
    print(f"the last step ({ago}): {step['cause']}{decided}")
    marks = {"success": "+", "failure": "-", "running": "~", "idle": "."}
    for node in document.get("nodes", []):
        name = f" \"{node['name']}\"" if node["name"] else ""
        values = " ".join(f"{key}={value:g}" if isinstance(value, (int, float)) else f"{key}={value}"
                          for key, value in node["parameters"].items())
        print(f"  {marks.get(node['status'], '?')} {'  ' * node['depth']}{node['node']}{name}{' ' + values if values else ''}")
    board = document["blackboard"]
    keys = ", ".join(f"{key} {value:g}" for key, value in board.get("keys", {}).items())
    print(f"blackboard keys: {keys or '(none)'}")
    facts = ", ".join(f"{key} {value:g}" if isinstance(value, float) else f"{key} {value}" for key, value in board["facts"].items())
    print(f"facts: {facts}")


