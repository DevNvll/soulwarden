def whole(word: str, what: str) -> int:
    if not word.isdigit():
        fail(f"{what} must be a whole number, 0 or more")
    return int(word)


def coin_amount(word: str) -> int:
    """@return The amount in hundredths of a coin from a text such as 123.45."""
    if not re.fullmatch(r"[0-9]+(\.[0-9]{1,2})?", word):
        fail("give the coin as a number with 2 decimals at most, for example 123.45")
    units, _, cents = word.partition(".")
    return int(units) * 100 + int(cents.ljust(2, "0") or 0)


def numbers(words: list[str], count: int) -> list[float]:
    try:
        values = [float(word) for word in words]
    except ValueError:
        fail("a distance or a position must be a number")
    if len(values) != count:
        fail(f"give {count} numbers")
    return values


def creature_command(data_dir: Path, arguments: list[str]) -> None:
    action = arguments[0]
    if action == "spawn" and len(arguments) >= 3:
        options = ""
        words = arguments[3:]
        for name in ("--level", "--yaw"):
            if name in words:
                place = words.index(name)
                if place + 1 >= len(words):
                    fail(f"give a value after {name}")
                value = whole(words[place + 1], "the level") if name == "--level" else numbers(words[place + 1:place + 2], 1)[0]
                options += f"&{name[2:]}={value}"
                del words[place:place + 2]
        if not re.fullmatch(r"[A-Za-z0-9_:+-]+", arguments[1]):
            fail("the kind must be an id of the creature data (tools/world kinds)")
        if words:
            dx, dy, dz = numbers(words, 3)
            options += f"&dx={dx}&dy={dy}&dz={dz}"
        request(data_dir, "POST", f"/v1/dev/creatures/spawn?character={character_id(data_dir, arguments[2])}"
                                  f"&kind={arguments[1]}{options}")
    elif action in ("remove", "kill") and len(arguments) == 2:
        request(data_dir, "POST", f"/v1/dev/creatures/{action}?creature={creature_id(data_dir, arguments[1])}")
    elif action == "health" and len(arguments) == 3:
        value = arguments[2]
        if value.endswith("%"):
            amount = f"percent={numbers([value[:-1]], 1)[0]}"
        else:
            amount = f"health={numbers([value], 1)[0]}"
        request(data_dir, "POST", f"/v1/dev/creatures/health?creature={creature_id(data_dir, arguments[1])}&{amount}")
    elif action == "reset" and len(arguments) == 1:
        request(data_dir, "POST", "/v1/dev/creatures/reset")
    elif action == "action" and len(arguments) >= 3:
        words = arguments[3:]
        tags = ""
        if "--tags" in words:
            place = words.index("--tags")
            if place + 1 >= len(words) or not re.fullmatch(r"[0-9a-fA-F]{24}", words[place + 1]):
                fail("give 24 hexadecimal digits after --tags")
            tags = f"&tags={words[place + 1]}"
            del words[place:place + 2]
        if not re.fullmatch(r"[A-Za-z0-9_]+", arguments[2]) or len(words) > 1:
            fail("the action must be a name of the action table of the slice (letters, digits, and _)")
        seconds = f"&seconds={numbers(words, 1)[0]}" if words else ""
        request(data_dir, "POST", f"/v1/dev/creatures/action?creature={creature_id(data_dir, arguments[1])}"
                                  f"&action={arguments[2]}{seconds}{tags}")
    elif action == "shoot" and len(arguments) == 3:
        request(data_dir, "POST", f"/v1/dev/creatures/shoot?creature={creature_id(data_dir, arguments[1])}"
                                  f"&character={character_id(data_dir, arguments[2])}")
    elif action == "area" and len(arguments) == 3:
        request(data_dir, "POST", f"/v1/dev/creatures/area?creature={creature_id(data_dir, arguments[1])}"
                                  f"&character={character_id(data_dir, arguments[2])}")
    elif action == "status-action" and len(arguments) in (2, 3):
        if len(arguments) == 3 and not re.fullmatch(r"[A-Za-z0-9_]+", arguments[2]):
            fail("the action must be a name of the action table of the slice (letters, digits, and _)")
        named = f"&action={arguments[2]}" if len(arguments) == 3 else ""
        request(data_dir, "POST", f"/v1/dev/creatures/status-action?creature={creature_id(data_dir, arguments[1])}{named}")
    elif action == "tree" and len(arguments) == 2 and arguments[1] == "reload":
        request(data_dir, "POST", "/v1/dev/creatures/tree/reload")
    elif action == "tree" and len(arguments) == 2:
        request(data_dir, "GET", f"/v1/dev/creatures/tree?creature={creature_id(data_dir, arguments[1])}")
    elif action == "anchor" and len(arguments) == 5:
        x, y, z = numbers(arguments[2:5], 3)
        request(data_dir, "POST", f"/v1/dev/creatures/anchor?creature={creature_id(data_dir, arguments[1])}&x={x}&y={y}&z={z}")
    elif action == "respawn" and len(arguments) == 3:
        seconds = numbers(arguments[2:3], 1)[0]
        request(data_dir, "POST", f"/v1/dev/creatures/respawn?creature={creature_id(data_dir, arguments[1])}&seconds={seconds}")
    elif action == "effect" and len(arguments) in (3, 4):
        if not re.fullmatch(r"[A-Za-z0-9_]+", arguments[2]):
            fail("the status must be the id of a status row of the ability data, or knockdown or stagger")
        seconds = f"&seconds={numbers(arguments[3:4], 1)[0]}" if len(arguments) == 4 else ""
        request(data_dir, "POST", f"/v1/dev/creatures/effect?creature={creature_id(data_dir, arguments[1])}"
                                  f"&status={arguments[2]}{seconds}")
    else:
        fail("unknown creature command. tools/world --help prints the commands.")


def main() -> None:
    arguments = sys.argv[1:]
    if not arguments or arguments[0] in ("-h", "--help"):
        print(__doc__.strip())
        return
    data_dir = dev_env.data_dir()
    command = arguments[0]
    if command == "list" and len(arguments) == 1:
        request(data_dir, "GET", "/v1/dev/world")
    elif command == "characters" and len(arguments) == 1:
        for identifier, name in characters(data_dir):
            print(f"{identifier}  {name}")
    elif command == "spawn" and len(arguments) >= 3:
        target = character_id(data_dir, arguments[1])
        if arguments[2] == "--at":
            x, y, z = numbers(arguments[3:], 3)
            request(data_dir, "POST", f"/v1/dev/world/spawn?character={target}&x={x}&y={y}&z={z}")
        elif arguments[2] == "--near" and len(arguments) >= 4:
            other = character_id(data_dir, arguments[3])
            dx, dy, dz = numbers(arguments[4:], 3) if len(arguments) > 4 else (2.0, 2.0, 0.0)
            request(data_dir, "POST", f"/v1/dev/world/spawn?character={target}&near={other}&dx={dx}&dy={dy}&dz={dz}")
        else:
            fail("give the position: --at X Y Z, or --near OTHER [DX DY DZ]")
    elif command == "fragment" and len(arguments) == 5:
        try:
            slot, type_index = int(arguments[2]), int(arguments[3])
            state = bytes.fromhex(arguments[4]).hex()
        except ValueError:
            fail("give the slot and the type as numbers, and the state as hexadecimal text")
        # A text of hexadecimal digits that is not the name of a character is the id of a creature.
        names = [name for _, name in characters(data_dir)]
        if re.fullmatch(r"[0-9a-fA-F]{1,16}", arguments[1]) and arguments[1] not in names:
            target = f"creature={creature_id(data_dir, arguments[1])}"
        else:
            target = f"character={character_id(data_dir, arguments[1])}"
        request(data_dir, "POST", f"/v1/dev/world/fragment?{target}&slot={slot}&type={type_index}&state={state}")
    elif command == "probe" and len(arguments) >= 3:
        if arguments[1] == "remove" and len(arguments) == 3:
            request(data_dir, "POST", f"/v1/dev/world/probe/remove?entity={arguments[2].lower()}")
            return
        if arguments[1] == "fragment" and len(arguments) == 6:
            try:
                slot, type_index = int(arguments[3]), int(arguments[4])
                state = bytes.fromhex(arguments[5]).hex()
            except ValueError:
                fail("give the slot and the type as numbers, and the state as hexadecimal text")
            request(data_dir, "POST", f"/v1/dev/world/fragment?entity={arguments[2].lower()}&slot={slot}"
                                      f"&type={type_index}&state={state}")
            return
        target = character_id(data_dir, arguments[1])
        asset = arguments[2].replace("-", "").lower()
        if not re.fullmatch(r"[0-9a-f]{32}", asset):
            fail("give the asset id of the slice: 32 hexadecimal digits")
        rest = arguments[3:]
        options = {"--sub": "2", "--radius": "", "--actor": ""}
        fragments: list[str] = []
        offsets: list[str] = []
        index = 0
        while index < len(rest):
            word = rest[index]
            if word in options and index + 1 < len(rest):
                options[word] = rest[index + 1]
                index += 2
            elif word == "--fragment" and index + 1 < len(rest):
                part = rest[index + 1].split(":")
                if len(part) != 3:
                    fail("a fragment is SLOT:TYPE:HEX")
                try:
                    fragments.append(f"{int(part[0])}:{int(part[1])}:{bytes.fromhex(part[2]).hex()}")
                except ValueError:
                    fail("a fragment is SLOT:TYPE:HEX (numbers and hexadecimal text)")
                index += 2
            else:
                offsets.append(word)
                index += 1
        dx, dy, dz = numbers(offsets, 3) if offsets else (0.0, 3.0, 0.0)
        query = f"near={target}&asset={asset}&sub={whole(options['--sub'], 'the sub id')}&dx={dx}&dy={dy}&dz={dz}"
        if options["--radius"]:
            query += f"&radius={numbers([options['--radius']], 1)[0]}"
        if options["--actor"]:
            actor = options["--actor"].lower()
            if not re.fullmatch(r"[0-9a-f]{32}", actor):
                fail("give the actor id: 32 hexadecimal digits")
            query += f"&actor={actor}"
        if fragments:
            query += "&fragments=" + ",".join(fragments)
        request(data_dir, "POST", f"/v1/dev/world/probe?{query}")
    elif command == "cast" and len(arguments) in (3, 5) and (len(arguments) == 3 or arguments[3] == "--yaw"):
        yaw = numbers(arguments[4:], 1)[0] if len(arguments) == 5 else 0.0
        request(data_dir, "POST", f"/v1/dev/abilities/cast?character={character_id(data_dir, arguments[1])}"
                                  f"&place={whole(arguments[2], 'the place')}&yaw={yaw}")
    elif command == "shoot" and len(arguments) >= 2:
        options = arguments[2:]
        query = f"character={character_id(data_dir, arguments[1])}"
        while options:
            if options[0] in ("--yaw", "--pitch") and len(options) >= 2:
                query += f"&{options[0][2:]}={numbers(options[1:2], 1)[0]}"
                options = options[2:]
            elif options[0] == "--heavy":
                query += "&heavy=1"
                options = options[1:]
            else:
                fail(f"unknown option {options[0]}: give --yaw DEGREES, --pitch DEGREES, --heavy")
        request(data_dir, "POST", f"/v1/dev/projectiles/shoot?{query}")
    elif command == "projectiles" and len(arguments) == 1:
        document = fetch(data_dir, "/v1/dev/world")
        print(projectiles_text(document["load"]["projectiles"]))
    elif command == "stamina" and len(arguments) == 1:
        document = fetch(data_dir, "/v1/dev/world")
        print(stamina_text(document["load"]["stamina"]))
    elif command == "spells" and len(arguments) == 1:
        document = fetch(data_dir, "/v1/dev/world")
        print(spells_text(document["load"]["spells"]))
    elif command == "spells" and len(arguments) == 3 and arguments[1] == "end":
        request(data_dir, "POST", f"/v1/dev/spells/end?character={character_id(data_dir, arguments[2])}")
    elif command == "spells" and len(arguments) == 4 and arguments[1] == "hurt":
        try:
            amount = float(arguments[3])
        except ValueError:
            fail("give the damage as a number")
        request(data_dir, "POST", f"/v1/dev/spells/hurt?entity={arguments[2]}&amount={amount}")
    elif command == "message" and len(arguments) == 4:
        try:
            type_index = int(arguments[2])
            body = bytes.fromhex(arguments[3]).hex()
        except ValueError:
            fail("give the type as a number, and the body as hexadecimal text")
        request(data_dir, "POST", f"/v1/dev/world/message?character={character_id(data_dir, arguments[1])}"
                                  f"&type={type_index}&body={body}")
    elif command == "creatures" and len(arguments) in (1, 2, 3):
        query = f"?character={character_id(data_dir, arguments[1])}" if len(arguments) > 1 else ""
        if len(arguments) == 3:
            query += f"&range={numbers(arguments[2:], 1)[0]}"
        request(data_dir, "GET", f"/v1/dev/creatures{query}")
    elif command == "kinds" and len(arguments) in (1, 2):
        if len(arguments) == 2 and not re.fullmatch(r"[A-Za-z0-9_:+-]+", arguments[1]):
            fail("the text can have letters, digits, and the characters _ : + -")
        request(data_dir, "GET", "/v1/dev/creatures/kinds" + (f"?q={arguments[1]}" if len(arguments) == 2 else ""))
    elif command == "creature" and len(arguments) >= 2:
        creature_command(data_dir, arguments[1:])
    elif command == "items" and len(arguments) == 2:
        request(data_dir, "GET", f"/v1/dev/items?character={character_id(data_dir, arguments[1])}")
    elif command == "give" and 3 <= len(arguments) <= 10:
        extra = ""
        for option, name in (("--action", "action"), ("--gs", "gearScore"), ("--perks", "perks")):
            if option in arguments[3:]:
                position = arguments.index(option, 3)
                if position + 1 >= len(arguments):
                    fail(f"give a value after {option}")
                value = arguments[position + 1]
                if name == "perks":
                    if not re.fullmatch(r"[A-Za-z0-9_,]*", value) or value.count(",") > 4:
                        fail("--perks: at most five PerkID texts with \",\" between them (an empty part: no perk)")
                    extra += f"&perks={value}"
                else:
                    extra += f"&{name}={whole(value, option)}"
                arguments = arguments[:position] + arguments[position + 2:]
        if len(arguments) not in (3, 4):
            fail("tools/world give CHARACTER ITEM [QUANTITY] [--action N] [--gs N] [--perks P1,P2,P3,P4,P5]")
        if not re.fullmatch(r"[A-Za-z0-9_.-]+", arguments[2]):
            fail("the item must be the ItemID text of the item catalog")
        quantity = whole(arguments[3], "the quantity") if len(arguments) == 4 else 1
        request(data_dir, "POST", f"/v1/dev/items/give?character={character_id(data_dir, arguments[1])}"
                                  f"&item={arguments[2]}&quantity={quantity}{extra}")
    elif command == "take" and len(arguments) in (3, 4):
        quantity = f"&quantity={whole(arguments[3], 'the quantity')}" if len(arguments) == 4 else ""
        request(data_dir, "POST", f"/v1/dev/items/remove?character={character_id(data_dir, arguments[1])}"
                                  f"&slot={whole(arguments[2], 'the slot')}{quantity}")
    elif command == "coin" and len(arguments) == 3:
        request(data_dir, "POST", f"/v1/dev/items/coin?character={character_id(data_dir, arguments[1])}"
                                  f"&amount={coin_amount(arguments[2])}")
    elif command == "move" and len(arguments) == 4:
        request(data_dir, "POST", f"/v1/dev/items/move?character={character_id(data_dir, arguments[1])}"
                                  f"&from={whole(arguments[2], 'the slot')}&to={whole(arguments[3], 'the slot')}")
    elif command == "split" and len(arguments) in (4, 5):
        target = f"&to={whole(arguments[4], 'the slot')}" if len(arguments) == 5 else ""
        request(data_dir, "POST", f"/v1/dev/items/split?character={character_id(data_dir, arguments[1])}"
                                  f"&slot={whole(arguments[2], 'the slot')}&quantity={whole(arguments[3], 'the quantity')}{target}")
    elif command == "lock" and len(arguments) == 4 and arguments[3] in ("on", "off"):
        request(data_dir, "POST", f"/v1/dev/items/lock?character={character_id(data_dir, arguments[1])}"
                                  f"&slot={whole(arguments[2], 'the slot')}&locked={1 if arguments[3] == 'on' else 0}")
    elif command == "equipment" and len(arguments) == 2:
        request(data_dir, "GET", f"/v1/dev/items?character={character_id(data_dir, arguments[1])}", show_bag=False)
    elif command == "equip" and len(arguments) in (3, 4):
        slot = f"&slot={whole(arguments[3], 'the slot of the paperdoll')}" if len(arguments) == 4 else ""
        request(data_dir, "POST", f"/v1/dev/items/equip?character={character_id(data_dir, arguments[1])}"
