def fetch(data_dir: Path, path: str) -> dict:
    """@return The JSON reply of a GET request, with no output."""
    process, port = backend(data_dir)
    command = ["nsenter", "-t", str(process), "-U", "-n", "--preserve-credentials", "curl", "--silent", "--max-time", "5",
               f"http://127.0.0.1:{port}{path}"]
    result = subprocess.run(command, capture_output=True, text=True, check=False)
    if result.returncode != 0:
        fail(f"no reply of the backend (nsenter and curl gave status {result.returncode}): {result.stderr.strip()}")
    try:
        return json.loads(result.stdout)
    except ValueError:
        fail("the backend has no development commands for creatures (start it with tools/dev-run.sh)")
        return {}


def creature_id(data_dir: Path, text: str) -> str:
    """@return The id of the creature whose id is the text, or ends with it."""
    if not re.fullmatch(r"[0-9a-fA-F]{1,16}", text):
        fail("the creature must be its id (hexadecimal digits)")
    if len(text) == 16:
        return text.lower()
    found = [creature["id"] for creature in fetch(data_dir, "/v1/dev/creatures").get("creatures", [])
             if creature["id"].endswith(text.lower())]
    if len(found) != 1:
        fail(f"{len(found)} creatures of the world have an id that ends with {text}")
    return found[0]


def creature_text(creature: dict) -> str:
    x, y, z = creature["position"]
    distance = f"  {creature['distance']:6.1f} m" if "distance" in creature else ""
    # What the creature does: it has a target, or it goes to its home. No word: it is at rest.
    mode = {"fight": f"  FIGHT (target {creature.get('target', '')[-8:]})", "home": "  GOES BACK (immune)"}.get(creature.get("mode"), "")
    if creature.get("holds"):
        mode += "  WAITS (no way to its target)"
    if creature.get("retracing"):
        mode += "  ON ITS TRAIL"
    if creature.get("forced"):
        mode += f"  MOVED BY A HIT ({creature['forced']})"
    # The roam (stage 3.4e): a patrol with its waypoint, or a wander, and if the creature roams now (a character is near).
    roam = creature.get("roam", "none")
    stands = ""
    if not creature.get("roaming") and creature.get("mode") == "rest":
        if not creature.get("behaviorData", True):
            stands = "stands: no behavior data of its slice"
        elif not creature.get("groundKnown"):
            stands = "stands: no navigation data of its place yet"
        elif not creature.get("walks"):
            stands = "stands: no free floor at its place"
        else:
            stands = "stands: no character near"
    if roam == "patrol":
        mode += f"  PATROL (waypoint {creature.get('waypoint', 0) + 1} of {creature.get('waypoints', 0)}"
        if creature.get("settled"):
            mode += ", stays there)"
        else:
            mode += f", {stands})" if stands else ")"
    elif roam == "wander":
        mode += "  WANDER" + (f" ({stands})" if stands else "")
    kind = "" if creature.get("fights", True) else "  no attack"
    rooted = creature.get("groundKnown", True) and not creature.get("walks", True)
    kind += "  stays at its place" if rooted and creature.get("fights", True) else ""
    if "respawnIn" in creature:
        kind += f"  its spawn point makes a new creature in {creature['respawnIn']:.0f} s (a player near it)"
    return (f"creature {creature['id']}  {creature['kind']:<28} {creature['name']:<22} level {creature['level']:>2}  "
            f"health {creature['health']:.1f} of {creature['healthMax']:.1f}{'  DEAD' if creature['dead'] else ''}  "
            f"position {x:.3f} {y:.3f} {z:.3f}{distance}  {'spawn point' if creature['spawnPoint'] else 'command'}"
            f"{mode}{kind}")


def show_creatures(document: dict) -> None:
    if not document["data"]:
        print("the backend has no creature data: make the file with tools/gamedata/creatures.sh")
        return
    for creature in document["creatures"]:
        print(creature_text(creature))
    counts = document["counts"]
    print(f"{len(document['creatures'])} creatures in the list, {document['total']} in the world; "
          f"{document['spawnPoints']} spawn points, {document['spawnPointsWaiting']} of them wait; made by a spawn point "
          f"{counts['spawnedByPoint']}, by a command {counts['spawnedByCommand']}; removed by the distance rule "
          f"{counts['removedByDistance']}, by a command {counts['removedByCommand']}; deaths {counts['deaths']}; the "
          f"largest number at one time {counts['largest']}")


def show_progress(document: dict) -> None:
    place = "in the world" if document["inWorld"] else "not in the world"
    following = document["nextLevelExperience"]
    print(f"level {document['level']}, experience {document['experience']}"
          + (f" (the next level starts at {following})" if following else "")
          + f", health {document['health']:.0f} of {document['healthMax']:.0f} (the character is {place})")
    values = ", ".join(f"{name} {entry['value']}" for name, entry in document["attributes"].items())
    print(f"attributes: {values}; {document['freeAttributePoints']} free point(s)")
    if not document["tables"]:
        print("the backend has no progression tables: no list of the weapons and of the trade skills")
        return
    for weapon in document["weapons"]:
        if weapon["level"] == 1 and not weapon["experience"] and not weapon["nodes"]:
            continue
        bar = ", ".join(place or "-" for place in weapon["bar"])
        print(f"weapon {weapon['id']:<26} level {weapon['level']:>2}, experience {weapon['experience']} of "
              f"{weapon['nextLevel']}, {weapon['freePoints']} free and {weapon['spentPoints']} spent point(s)")
        if weapon["nodes"]:
            print(f"    nodes: {', '.join(weapon['nodes'])}")
            print(f"    bar: {bar}")
    for skill in document["tradeSkills"]:
        if skill["level"] or skill["experience"]:
            print(f"trade skill {skill['id']:<21} level {skill['level']:>3}, experience {skill['experience']} of "
                  f"{skill['nextLevel']}")
    weapons = sum(1 for weapon in document["weapons"] if weapon["level"] > 1 or weapon["experience"] or weapon["nodes"])
    skills = sum(1 for skill in document["tradeSkills"] if skill["level"] or skill["experience"])
    print(f"{weapons} of {len(document['weapons'])} weapons and {skills} of {len(document['tradeSkills'])} trade skills "
          "are above the start")


def show_ownership(document: dict) -> None:
