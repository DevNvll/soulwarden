        target = character_id(data_dir, arguments[1])
        if arguments[2] == "charge" and len(arguments) == 4:
            request(data_dir, "POST", f"/v1/dev/rune/charge?character={target}&percent={numbers(arguments[3:], 1)[0]}",
                    show_bag=False)
        elif arguments[2] == "activate" and len(arguments) == 3:
            request(data_dir, "POST", f"/v1/dev/rune/activate?character={target}", show_bag=False)
        else:
            fail("tools/world rune CHARACTER charge PERCENT|activate")
    elif command == "heals" and len(arguments) in (2, 3):
        query = f"character={character_id(data_dir, arguments[1])}"
        if len(arguments) == 3:
            query += f"&target={character_id(data_dir, arguments[2])}"
        request(data_dir, "GET", f"/v1/dev/heals?{query}")
    elif command == "friends" and len(arguments) == 3:
        request(data_dir, "POST", f"/v1/dev/world/friends?character={character_id(data_dir, arguments[1])}"
                                  f"&friend={character_id(data_dir, arguments[2])}")
    elif command == "status" and 2 <= len(arguments) <= 6:
        target = character_id(data_dir, arguments[1])
        if len(arguments) == 2:
            document = fetch(data_dir, f"/v1/dev/status?character={target}")
            print(json.dumps(document, indent=1, sort_keys=True))
        elif arguments[2] == "remove" and len(arguments) == 4:
            if not re.fullmatch(r"[A-Za-z0-9_]+", arguments[3]):
                fail("tools/world status CHARACTER remove STATUS|all")
            request(data_dir, "POST", f"/v1/dev/status/remove?character={target}&status={arguments[3]}", show_bag=False)
        elif re.fullmatch(r"[A-Za-z0-9_]+", arguments[2]):
            query = f"character={target}&status={arguments[2]}"
            if len(arguments) >= 4:
                query += f"&seconds={numbers(arguments[3:4], 1)[0]}"
            if len(arguments) >= 5:
                query += f"&count={whole(arguments[4], 'the count')}"
            if len(arguments) == 6:
                query += f"&potency={numbers(arguments[5:6], 1)[0]}"
            request(data_dir, "POST", f"/v1/dev/status?{query}", show_bag=False)
        else:
            fail("tools/world status CHARACTER [STATUS [SECONDS [COUNT [POTENCY]]]] | tools/world status CHARACTER remove STATUS|all")
    elif command == "perkroll" and len(arguments) >= 2:
        if not re.fullmatch(r"[A-Za-z0-9_]+", arguments[1]):
            fail("the item must be an ItemID of the item catalog")
        query = f"item={arguments[1]}"
        words = arguments[2:]
        while words:
            word = words.pop(0)
            if word in ("--gs", "--level", "--count") and words:
                query += f"&{word[2:]}={whole(words.pop(0), word[2:])}"
            else:
                fail("tools/world perkroll ITEM [--gs N] [--level N] [--count N]")
        document = fetch(data_dir, f"/v1/dev/perks/roll?{query}")
        print(json.dumps(document, indent=1, sort_keys=True))
    elif command == "hurt" and len(arguments) == 3:
        request(data_dir, "POST", f"/v1/dev/world/hurt?character={character_id(data_dir, arguments[1])}"
                                  f"&amount={numbers(arguments[2:], 1)[0]}")
    elif command in ("remove", "touch") and len(arguments) == 2:
        request(data_dir, "POST", f"/v1/dev/world/{command}?character={character_id(data_dir, arguments[1])}")
    else:
        fail("unknown command. tools/world --help prints the commands.")


if __name__ == "__main__":
