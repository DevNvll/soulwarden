def spells_text(spells: dict) -> str:
    """@return The lines `spells` of the list (stage 3.3b-S2a): the spell entities with their age, and the counts."""
    if not spells["data"]:
        head = "spells: the backend has no spell data (tools/gamedata/spells.sh): a spell has its hits and no record"
    else:
        head = "spells:"
    ended = ", ".join(f"{count} {cause}" for cause, count in spells["ended"].items() if count)
    lines = [f"{head} {len(spells['spells'])} in the world, {spells['made']} made, ended: {ended or 'none'}; {spells['phases']} phases ran, "
             f"{spells['phasesCancelled']} cancelled, {spells['dueTaken']} due entries taken, {spells['largest']} at one time at most; "
             f"{spells.get('shots', 0)} shots of summons, {spells.get('summonHits', 0)} hits on summons, {spells.get('triggers', 0)} trap "
             f"triggers ({spells.get('trapHits', 0)} hits), {spells.get('auraGiven', 0)} aura statuses given, {spells.get('auraTaken', 0)} "
             f"taken back, {spells.get('looked', 0)} entities looked at"]
    for spell in spells["spells"]:
        x, y, z = spell["position"]
        extra = ""
        if "health" in spell:
            extra += f"  health {spell['health'][0]:.1f} of {spell['health'][1]:.1f}"
        if "attached" in spell:
            extra += f"  attached to {spell['attached']}"
        if "members" in spell:
            extra += f"  friends in it: {', '.join(spell['members']) or 'none'}"
        if spell.get("ending"):
            extra += "  (its end chain runs)"
        lines.append(f"  spell {spell['entity']}  {spell['spell']} ({spell.get('role', 'area')}) of {spell['caster']}  age {spell['age']:.2f} s, "
                     f"{spell['left']:.2f} s left  at {x:.2f} {y:.2f} {z:.2f}{extra}{'' if spell['record'] else '  (no record: no slice data)'}")
    return "\n".join(lines)


def projectiles_text(projectiles: dict) -> str:
    """@return The lines `projectiles` of the list (stage 3.3b-S3): the projectiles in the air, the shots, and the ends."""
    if not projectiles["data"]:
        return "projectiles: the backend has no projectile data (tools/gamedata/projectiles.sh) or no combat tables: each shot is refused"
    shots = ", ".join(f"{count} {verdict}" for verdict, count in projectiles["shots"].items()) or "none"
    ends = ", ".join(f"{count} {cause}" for cause, count in projectiles["ends"].items()) or "none"
    lines = [f"projectiles: {len(projectiles['flying'])} in the air, shots: {shots}; ends: {ends}; {projectiles['damage']} hits with damage, "
             f"{projectiles['steps']} flight steps, {projectiles['looked']} creatures looked at, {projectiles['lineCells']} cells of "
             f"{projectiles['lineTests']} line tests ({projectiles['lineStopped']} stopped), {projectiles['largest']} in the air at one "
             f"time at most, {projectiles['ledger']} ledger entries"]
    for flying in projectiles["flying"]:
        x, y, z = flying["position"]
        lines.append(f"  projectile {flying['number']}  {flying['attack']} ({flying['row']}) of {flying['caster']}  age {flying['age']:.2f} s, "
                     f"{flying['travelled']:.1f} m  at {x:.2f} {y:.2f} {z:.2f}")
    creatures = projectiles.get("creatures")
    if creatures:
        ends = ", ".join(f"{count} {cause}" for cause, count in creatures["ends"].items()) or "none"
        lines.append(f"creature shots: {len(creatures['flying'])} in the air, {creatures['holds']} ended ones before their stop; "
                     f"{creatures['shots']} shots started, {creatures['releases']} releases flew, {creatures['releasesCancelled']} did "
                     f"not, {creatures['retreats']} walks back; {creatures['launches']} launches ({creatures['refused']} refused); ends: "
                     f"{ends}; {creatures['damage']} hits with damage, {creatures.get('evaded', 0)} passed a dodge, {creatures['steps']} flight steps, {creatures['looked']} "
                     f"characters looked at, {creatures['wallTests']} wall tests, {creatures['largest']} in the air at one time at most")
        for flying in creatures["flying"]:
            x, y, z = flying["position"]
            lines.append(f"  shot {flying['number']}  {flying['attack']} of creature {flying['creature']} (entity {flying['entity']})  age "
                         f"{flying['age']:.2f} s, {flying['travelled']:.1f} m  at {x:.2f} {y:.2f} {z:.2f}")
    return "\n".join(lines)


def stamina_text(stamina: dict) -> str:
    """@return The lines `stamina` of the list (stage 3.4f-B): the dodge inputs by verdict, the payments, and each character."""
    if not stamina["data"]:
        return "stamina: the backend has no stamina data (tools/gamedata/stamina.sh): no payment, no dodge rule of the server"
    dodges = ", ".join(f"{count} {verdict}" for verdict, count in stamina["dodges"].items()) or "none"
    lines = [f"stamina: dodges: {dodges}; {stamina['payments']} payments ({stamina['paymentsCancelled']} dodges ended before their "
             f"payment), {stamina['gains']} gains, {stamina['regenerationSteps']} regeneration steps, {stamina['emptied']} times empty, "
             f"{stamina['evaded']} creature hits avoided by a dodge"]
    for character in stamina["characters"]:
        line = (f"  {character['character'][:8]}  {character['stamina']:.1f} of {character['maximum']:.1f}"
                f"{'  exhausted' if character['exhausted'] else ''}  regeneration {character['regeneration']:.2f}/s")
        dodge = character.get("dodge")
        if dodge:
            line += (f"  dodge {dodge['fragment']} ({dodge['cost']:.0f}) {dodge['age']:.2f} s, {'paid' if dodge['paid'] else 'not paid'}"
                     f"{', immune' if dodge['immune'] else ''}")
