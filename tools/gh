#!/usr/bin/env bash
# Query the Ghidra MCP server. Start it first with tools/ghidra/start-mcp.sh.
set -euo pipefail
tool_directory="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
python_binary="${SOULWARDEN_PYTHON:-${HOME}/Games/soulwarden/venv/bin/python}"
exec "${python_binary}" -I "${tool_directory}/ghidra/mcp_call.py" "$@"
