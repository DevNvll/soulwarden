// The fight of a creature with a target (stages BT1 and BT2): the order of the questions of Behavior::think before the trees (stages 3.4b
// to 3.4f-D). Each subtree has one rule of the fight; its leaf fails when the slice of the creature does not have its ability, and the next
// child of the selector decides. The values are in the subtrees: the values of the namespace behavior_rules before the trees (project
// rules; the source of each one is in docs/systems/creature-behavior.md). Times in seconds, distances in meters.
{
  "$schema": "./tree.schema.json",
  "format": 1,
  "tree": "default/fight",
  "root": {
    "node": "sequence",
    "children": [
      // The target checks: a target that is gone (dead, left, ignored, the end of a summon), the end of the leash (the combat leash of the
      // slice from the anchor), a target farther than lose_distance (kLoseDistance; a creature that does not walk: the combat vision
      // distance of its slice). A lost target ends the step: the creature goes back.
      { "node": "keep_target", "lose_distance": 60 },
      {
        "node": "selector",
        "children": [
          { "node": "subtree", "tree": "default/status" },
          { "node": "subtree", "tree": "default/area" },
          { "node": "subtree", "tree": "default/shot" },
          { "node": "subtree", "tree": "default/cast" },
          { "node": "subtree", "tree": "default/melee" },
          // A creature with no melee attack and a target that it cannot shoot (a summon).
          { "node": "turn_to_target" }
        ]
      }
    ]
  }
}
