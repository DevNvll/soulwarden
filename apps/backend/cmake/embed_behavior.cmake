# Puts the text of the behavior tree files (apps/backend/behavior/*.jsonc) into one C++ source file (stage BT1): the backend has its
# trees with no file of the game data folder. A run of `cmake -P` with SOURCE_DIR (the folder of the files) and OUTPUT (the source file).
# The file names in the output are names with no folder: a product has no absolute path.

file(GLOB tree_files RELATIVE "${SOURCE_DIR}" "${SOURCE_DIR}/*.jsonc")
list(SORT tree_files)
set(content "// Generated by apps/backend/cmake/embed_behavior.cmake from apps/backend/behavior/*.jsonc. Do not change this file.\n")
string(APPEND content "#include \"world/behavior_tree.h\"\n\nnamespace soulwarden::backend::world::tree {\n\n")
string(APPEND content "const std::vector<EmbeddedFile>& embedded_tree_files() {\n    static const std::vector<EmbeddedFile> files = {\n")
foreach(name IN LISTS tree_files)
    file(READ "${SOURCE_DIR}/${name}" text)
    string(FIND "${text}" ")soulwarden_tree\"" clash)
    if(NOT clash EQUAL -1)
        message(FATAL_ERROR "${name}: the text has the end mark of the raw string of the generated file")
    endif()
    string(APPEND content "        {\"${name}\", R\"soulwarden_tree(${text})soulwarden_tree\"},\n")
endforeach()
string(APPEND content "    };\n    return files;\n}\n\n} // namespace soulwarden::backend::world::tree\n")
# Write only a change: an unchanged file does not build the library again.
set(old "")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" old)
endif()
if(NOT old STREQUAL content)
    file(WRITE "${OUTPUT}" "${content}")
endif()
